{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://limenora.dev/schemas/approval/submission.schema.json",
  "title": "LIMENORA Approval Submission",
  "description": "A reviewer's decision on a pending approval. Shared between the Go and Rust gateways.",
  "type": "object",
  "required": ["approval_id", "decision"],
  "properties": {
    "approval_id": { "type": "string" },
    "decision": {
      "type": "string",
      "enum": ["approve", "deny"]
    },
    "actor_id": { "type": "string" },
    "reason": { "type": "string" }
  },
  "additionalProperties": false
}
